# ── LLM 프록시 / API 키 ───────────────────────────────────────────────
# 사내 LiteLLM 프록시 또는 OpenAI 호환 게이트웨이 URL과 키
# 비워두면 앱 첫 화면에서 입력받아 이 파일에 자동 저장됨
UBION_LITELLM_URL=
UBION_LITELLM_KEY=

# ── 백엔드 토글 ──────────────────────────────────────────────────────
LLM_BACKEND=litellm           # litellm | ollama
WHISPER_BACKEND=local         # local | litellm
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama

# ── 모델 (프로파일별) ────────────────────────────────────────────────
# 기본은 "저렴 모드" — 전부 deepseek-v4-flash 로 통일.
# 품질을 더 올리고 싶으면 docs/pricing.md 의 "프로파일별 추천" 참고
# 후 MODEL_STRONG / MODEL_CREATIVE 만 claude-sonnet-4-6 등으로 교체.
#
# ⭐ Studio 산출물(슬라이드/카드뉴스/보고서) 품질을 한 단계 올리고 싶으면:
#     MODEL_CREATIVE=claude-sonnet-4-6
#   → 한국어 자연스러움 + HTML/PPTX 구조화 안정성↑ (시나리오 B 기준 +$0.05)
MODEL_CHAT=deepseek-v4-flash
MODEL_EXTRACT=deepseek-v4-flash
MODEL_STRONG=deepseek-v4-flash
MODEL_CREATIVE=deepseek-v4-flash
TTS_MODEL=gpt-4o-mini-tts
STT_MODEL_LITELLM=gpt-4o-transcribe

# ── 임베딩 (로컬 고정) ───────────────────────────────────────────────
EMBED_MODEL=BAAI/bge-m3
EMBED_DEVICE=auto             # auto | cpu | cuda

# ── 경로 ────────────────────────────────────────────────────────────
NOTEBOOK_ROOT=./data/notebooks

# ── OCR 분기 (기본 OFF) ──────────────────────────────────────────────
# true 면 PDF 를 MinerU(OCR/레이아웃) 로 처리. false 면 pypdf 텍스트 추출만 사용.
# 본 앱은 입력이 텍스트가 이미 추출되는 형식이라는 전제로 설계됨 — 스캔/이미지 PDF
# 는 외부 OCR 로 .txt 를 만들어 다시 업로드해 주세요.
ENABLE_MINERU=false

# ── 회사 PPTX 양식 (선택) ─────────────────────────────────────────────
# 양식 파일을 ./assets/pptx_template.pptx 에 두면 자동 사용.
# 다른 위치를 쓰려면 절대/상대 경로로 지정. 빈 값이면 내장 기본 테마.
# 스펙: docs/pptx_template_spec.md
PPTX_TEMPLATE_PATH=

# ── faster-whisper (STT 로컬) ────────────────────────────────────────
WHISPER_MODEL_CUDA=large-v3
WHISPER_MODEL_CPU=small
